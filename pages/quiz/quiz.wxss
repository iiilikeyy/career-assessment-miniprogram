/* pages/quiz/quiz.wxss */

.quiz-page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 200rpx;
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  padding-top: env(safe-area-inset-top);
  height: calc(88rpx + env(safe-area-inset-top));
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 20rpx;
  padding-right: 20rpx;
  background: #fff;
  z-index: 999;
  border-bottom: 1rpx solid #f0f2f5;
  box-sizing: border-box;
}

.nav-safe-area {
  height: calc(88rpx + env(safe-area-inset-top));
}

.nav-back {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 48rpx;
  color: #333;
  font-weight: 300;
  line-height: 1;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1a1a2e;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

.nav-placeholder {
  width: 70rpx;
}

/* 进度条 */
.progress-bar {
  width: 100%;
  height: 6rpx;
  background: #e8eaf0;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  transition: width 0.3s ease;
}

.progress-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
}

.progress-badge {
  display: flex;
  align-items: baseline;
}

.badge-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #667eea;
  line-height: 1;
}

.badge-total {
  font-size: 24rpx;
  color: #999;
  margin-left: 4rpx;
}

.progress-label {
  font-size: 24rpx;
  color: #999;
}

/* 题目卡片 */
.question-card {
  margin: 10rpx 30rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 36rpx 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.question-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #f5f7ff 0%, #fff0f6 100%);
  color: #667eea;
  font-size: 22rpx;
  font-weight: 500;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.question-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a2e;
  line-height: 1.6;
}

/* 选项 */
.options-wrap {
  padding: 10rpx 30rpx;
}

.option-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 18rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  animation: optionFadeIn 0.3s ease-out both;
}

@keyframes optionFadeIn {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.option-item:active {
  transform: scale(0.98);
  background: #f8f9ff;
}

.option-item.selected {
  border-color: #667eea;
  background: linear-gradient(135deg, #f5f7ff 0%, #f0f4ff 100%);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.2);
}

.option-radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #ddd;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.option-item.selected .option-radio {
  border-color: #667eea;
  background: #667eea;
}

.radio-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #ffffff;
}

.option-label {
  font-size: 29rpx;
  color: #333;
  flex: 1;
  line-height: 1.5;
  transition: all 0.2s ease;
}

.option-item.selected .option-label {
  color: #4c51bf;
  font-weight: 600;
}

.option-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
  flex-shrink: 0;
  animation: checkPop 0.3s cubic-bezier(0.68, -0.55, 0.27, 1.55);
}

@keyframes checkPop {
  0% {
    transform: scale(0);
    opacity: 0;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

/* 底部操作 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx 40rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.prev-btn {
  flex: 1;
}

.submit-btn {
  flex: 2;
}

.next-hint {
  flex: 2;
  text-align: center;
}

/* 加载中 */
.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60vh;
}
