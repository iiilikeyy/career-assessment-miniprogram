/* pages/result/result.wxss */

.result-page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 160rpx;
}

/* 结果头部 */
.result-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  text-align: center;
  padding: 60rpx 40rpx 80rpx;
}

.result-label {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 16rpx;
}

.result-title {
  font-size: 48rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.result-code {
  font-size: 24rpx;
  opacity: 0.8;
  letter-spacing: 4rpx;
}

/* 通用卡片 */
.radar-card,
.dimension-card,
.desc-card,
.careers-card,
.lock-card,
.full-report-card {
  margin: -30rpx 30rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  position: relative;
}

.dimension-card,
.desc-card,
.careers-card,
.lock-card,
.full-report-card {
  margin-top: 0;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 20rpx;
}

/* 雷达图 */
.radar-chart {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
}

/* 维度解析 */
.dimension-list {
  padding: 10rpx 0;
}

.dimension-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.dimension-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.dimension-item:first-child {
  padding-top: 0;
}

.dimension-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.dimension-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  display: flex;
  align-items: center;
}

.dimension-rank {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 50%;
  margin-right: 12rpx;
}

.dimension-score {
  font-size: 24rpx;
  color: #999;
}

.score-num {
  font-size: 32rpx;
  font-weight: 600;
  color: #667eea;
}

.score-max {
  font-size: 22rpx;
}

.dimension-bar {
  height: 8rpx;
  background: #f0f2f5;
  border-radius: 4rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.dimension-bar-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.5s ease;
}

.dimension-bar-fill.high {
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
}

.dimension-bar-fill.low {
  background: #cfd3dc;
}

.dimension-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 14rpx;
}

.dimension-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.dim-tag {
  padding: 6rpx 18rpx;
  background: #f5f7ff;
  color: #667eea;
  border-radius: 20rpx;
  font-size: 22rpx;
}

/* 描述文本 */
.desc-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
}

/* 职业标签 */
.career-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.career-tag {
  padding: 10rpx 24rpx;
  background: linear-gradient(135deg, #f5f7ff 0%, #fff0f6 100%);
  color: #667eea;
  border-radius: 30rpx;
  font-size: 26rpx;
}

/* 锁定卡片 */
.lock-card {
  text-align: center;
  background: linear-gradient(135deg, #fffbf0 0%, #fff5f8 100%);
  border: 2rpx dashed #ffd700;
}

.lock-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.lock-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 12rpx;
}

.lock-desc {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 24rpx;
}

.lock-benefits {
  text-align: left;
  margin: 0 auto 30rpx;
  display: inline-block;
}

.benefit-item {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.unlock-btn {
  width: 100%;
}

/* 完整报告 */
.full-report-card {
  background: #fafbff;
}

.full-desc {
  font-size: 28rpx;
  color: #555;
  line-height: 1.9;
  white-space: pre-wrap;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  padding: 10rpx 30rpx;
  margin-bottom: 20rpx;
}

.action-buttons button {
  flex: 1;
}

/* 加载中 */
.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60vh;
}

/* 广告位 */
.ad-banner {
  margin: 20rpx 30rpx;
}
