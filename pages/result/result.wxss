/* pages/result/result.wxss */

.result-page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 160rpx;
}

/* 结果头部 */
.result-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  text-align: center;
  padding: 60rpx 40rpx 80rpx;
}

.result-label {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 16rpx;
}

.result-title {
  font-size: 48rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.result-code {
  font-size: 24rpx;
  opacity: 0.8;
  letter-spacing: 4rpx;
}

/* 通用卡片 */
.radar-card,
.dimension-card,
.desc-card,
.personality-card,
.env-card,
.careers-card,
.lock-card,
.strengths-card,
.career-detail-card,
.advice-card {
  margin: -30rpx 30rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  position: relative;
}

.dimension-card,
.desc-card,
.personality-card,
.env-card,
.careers-card,
.lock-card,
.strengths-card,
.career-detail-card,
.advice-card {
  margin-top: 0;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.card-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

/* 雷达图 */
.radar-chart {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
}

/* 维度解析 */
.dimension-list {
  padding: 10rpx 0;
}

.dimension-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.dimension-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.dimension-item:first-child {
  padding-top: 0;
}

.dimension-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.dimension-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  display: flex;
  align-items: center;
}

.dimension-rank {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 50%;
  margin-right: 12rpx;
}

.dimension-score {
  font-size: 24rpx;
  color: #999;
}

.score-num {
  font-size: 32rpx;
  font-weight: 600;
  color: #667eea;
}

.score-max {
  font-size: 22rpx;
}

.dimension-bar {
  height: 8rpx;
  background: #f0f2f5;
  border-radius: 4rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.dimension-bar-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.5s ease;
}

.dimension-bar-fill.high {
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
}

.dimension-bar-fill.low {
  background: #cfd3dc;
}

.dimension-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 14rpx;
}

.dimension-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.dim-tag {
  padding: 6rpx 18rpx;
  background: #f5f7ff;
  color: #667eea;
  border-radius: 20rpx;
  font-size: 22rpx;
}

/* 描述文本 */
.desc-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
}

/* 职业标签 */
.career-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.career-tag {
  padding: 10rpx 24rpx;
  background: linear-gradient(135deg, #f5f7ff 0%, #fff0f6 100%);
  color: #667eea;
  border-radius: 30rpx;
  font-size: 26rpx;
}

/* AI 生涯教练入口 */
.coach-entry-card {
  margin: 24rpx 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.35);
}

.coach-entry-left {
  flex: 1;
}

.coach-entry-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.coach-entry-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.coach-entry-arrow {
  font-size: 48rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-left: 16rpx;
}

/* 锁定卡片 */
.lock-card {
  text-align: center;
  background: linear-gradient(135deg, #fffbf0 0%, #fff5f8 100%);
  border: 2rpx dashed #ffd700;
}

.lock-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.lock-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 12rpx;
}

.lock-desc {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 24rpx;
}

.lock-benefits {
  text-align: left;
  margin: 0 auto 30rpx;
  display: inline-block;
}

.benefit-item {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.unlock-btn {
  width: 100%;
}

/* 完整报告 */
.full-report-card {
  background: #fafbff;
}

.full-desc {
  font-size: 28rpx;
  color: #555;
  line-height: 1.9;
  white-space: pre-wrap;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  padding: 10rpx 30rpx;
  margin-bottom: 20rpx;
}

.action-buttons button {
  flex: 1;
}

/* 加载中 */
.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60vh;
}

/* 广告位 */
.ad-banner {
  margin: 20rpx 30rpx;
}

/* 性格特点 */
.personality-list {
  padding: 6rpx 0;
}

.personality-item {
  position: relative;
  padding: 14rpx 0 14rpx 24rpx;
  font-size: 28rpx;
  color: #444;
  line-height: 1.7;
}

.personality-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 26rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

/* 适合的工作环境 */
.env-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.env-tag {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #e0f7fa 0%, #e8f5e9 100%);
  color: #00897b;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 500;
}

/* 核心优势 */
.strengths-card {
  background: linear-gradient(135deg, #fffbf0 0%, #fff9f5 100%);
  border: 1rpx solid #ffe4b5;
}

.strengths-list {
  padding: 6rpx 0;
}

.strength-item {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
}

.strength-bullet {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff9a56 0%, #ff6b6b 100%);
  margin-top: 14rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.strength-text {
  font-size: 28rpx;
  color: #444;
  line-height: 1.7;
  flex: 1;
}

/* 详细职业推荐 */
.career-detail-card {
  background: #f8faff;
  border: 1rpx solid #e0e7ff;
}

.career-detail-list {
  padding: 6rpx 0;
}

.career-detail-item {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
}

.career-dot {
  color: #667eea;
  font-size: 16rpx;
  margin-right: 14rpx;
  margin-top: 10rpx;
  flex-shrink: 0;
}

.career-detail-text {
  font-size: 27rpx;
  color: #444;
  line-height: 1.7;
  flex: 1;
}

/* 发展建议 */
.advice-card {
  background: linear-gradient(135deg, #f0f9ff 0%, #f0fdfa 100%);
  border: 1rpx solid #bae6fd;
}

.advice-text {
  font-size: 28rpx;
  color: #444;
  line-height: 1.9;
  padding: 6rpx 0;
}
