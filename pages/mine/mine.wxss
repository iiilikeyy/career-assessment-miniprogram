/* pages/mine/mine.wxss */

.mine-page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 40rpx;
}

/* 用户卡片 */
.user-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 50rpx 40rpx;
  display: flex;
  align-items: center;
  color: #fff;
}

.avatar-btn {
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  margin: 0;
  margin-right: 24rpx;
  background: transparent;
  border: none;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  margin-right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
}

.user-info {
  flex: 1;
}

.nickname {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.nickname-input {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  padding: 0;
  margin-bottom: 8rpx;
  min-height: 44rpx;
}

.nickname-placeholder {
  color: rgba(255, 255, 255, 0.6);
  font-weight: normal;
}

.user-id,
.user-desc {
  font-size: 24rpx;
  opacity: 0.8;
}

.arrow {
  font-size: 36rpx;
  opacity: 0.7;
}

/* 区块卡片 */
.section-card {
  margin: 24rpx 30rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  padding: 24rpx 30rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  border-bottom: 1rpx solid #f0f2f5;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-hint {
  font-size: 24rpx;
  color: #999;
  font-weight: normal;
}

/* 测评记录列表 */
.record-list {
  padding: 0 30rpx;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.record-item:last-child {
  border-bottom: none;
}

.record-info {
  flex: 1;
}

.record-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.record-time {
  font-size: 22rpx;
  color: #999;
}

.record-status {
  margin-right: 10rpx;
}

.status-unlocked {
  font-size: 22rpx;
  color: #52c41a;
  background: #f6ffed;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.status-locked {
  font-size: 22rpx;
  color: #999;
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.empty-record {
  text-align: center;
  padding: 60rpx 30rpx;
}

.empty-record .btn-secondary {
  display: inline-block;
  width: auto;
  padding: 0 40rpx;
  font-size: 26rpx;
}

/* 设置列表 */
.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #f0f2f5;
  font-size: 28rpx;
  color: #333;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-item:active {
  background: #fafafa;
}

/* 底部说明 */
.footer-note {
  text-align: center;
  padding: 40rpx 0;
}
