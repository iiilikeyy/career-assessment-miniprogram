/* components/share-card/share-card.wxss */
.share-card-wrapper {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  animation: fadeIn 0.25s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.share-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
}

.share-modal {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 90%;
  max-width: 660rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 30rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: modalPop 0.3s cubic-bezier(0.68, -0.55, 0.27, 1.55);
}

@keyframes modalPop {
  from {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.85);
  }
  to {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}

.share-header {
  text-align: center;
  margin-bottom: 24rpx;
}

.share-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}

.share-subtitle {
  font-size: 24rpx;
  color: #999;
}

.share-canvas-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.share-canvas {
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
}

.share-tip {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.share-actions {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.share-actions button {
  flex: 1;
}
